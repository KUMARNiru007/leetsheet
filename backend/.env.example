# Server
PORT=8080

# PostgreSQL connection string (local or Render)
DATABASE_URL=

# JWT secrets (note the spelling is intentional to match the code: JWT_REFERSH_TOKEN_SECRET)
JWT_REFERSH_TOKEN_SECRET=
JWT_ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Judge0 (RapidAPI) config
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
JUDGE0_RAPIDAPI_KEY=
JUDGE0_TIMEOUT_MS=60000
JUDGE0_RETRIES=3
JUDGE0_BACKOFF_MS=500

# Optional test parameters (only for local testing)
# JUDGE0_TEST_SOURCE_CODE=print("hello")
# JUDGE0_TEST_LANGUAGE_ID=71

# Comma-separated list of allowed frontend origins.
# Dev: http://localhost:5173   Prod: https://leetsheet-pi.vercel.app
FRONTEND_URL=http://localhost:5173

# Base URL of THIS backend, used to build the email verification link.
# Dev: http://localhost:8080   Prod: https://leetsheet.onrender.com
BASE_URI=http://localhost:8080

# Cookie domain for cross-subdomain cookies.
# Leave EMPTY when frontend and API are on different apex domains (Vercel + Render),
# and on localhost. Only set it (e.g. .leetsheet.in) if you own a shared apex domain.
COOKIE_DOMAIN=

# Mailtrap / SMTP settings
MAILTRAP_HOST=
MAILTRAP_PORT=
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
MAILTRAP_SENDERMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dev: http://localhost:8080/api/v1/auth/google/callback
# Prod: https://leetsheet.onrender.com/api/v1/auth/google/callback
# (also add the same URI as an authorized redirect URI in the Google Console)
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# express-session secret
SESSION_SECRET=